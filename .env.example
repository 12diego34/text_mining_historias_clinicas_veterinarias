# Copiar a .env y completar

# Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,healthcheck.railway.app

# Producción (Railway configura RAILWAY_PUBLIC_DOMAIN automáticamente)
# DEBUG=False
# CSRF_TRUSTED_ORIGINS=https://tu-app.up.railway.app

# OCR backend: 'claude' o 'ollama'
OCR_BACKEND=claude

# Claude API (si OCR_BACKEND=claude)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5

# Ollama (si OCR_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision:11b

# Para producción con Postgres (opcional, por defecto usa SQLite)
# DB_NAME=fichas_vet
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
